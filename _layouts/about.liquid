---
layout: default
---
<div class="post academic-home">
  <header class="intro">
    <div class="intro-copy">
      <p class="eyebrow">Research &amp; practice</p>
      <h1>
        {{ site.first_name }}
        {{ site.last_name }}
      </h1>
      <p class="intro-role">{{ page.subtitle }}</p>
      <nav class="profile-links" aria-label="Contact and research profiles">
        <a href="mailto:{{ site.data.socials.email }}">Email</a>
        <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}">Google Scholar</a>
        <a href="https://github.com/{{ site.data.socials.github_username }}">GitHub</a>
        <a href="https://orcid.org/{{ site.data.socials.orcid_id }}">ORCID</a>
        <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}/">LinkedIn</a>
        <a href="https://x.com/{{ site.data.socials.x_username }}" aria-label="X (Twitter)">X</a>
      </nav>
    </div>
    {% if page.profile.image %}
      <img
        class="intro-portrait"
        src="{{ page.profile.image | prepend: '/assets/img/' | relative_url }}"
        alt="{{ site.first_name }} {{ site.last_name }}"
        width="164"
        height="184"
        fetchpriority="high"
      >
    {% endif %}
  </header>
  <article>
    <div class="biography">{{ content }}</div>
    {% if page.news and site.announcements.enabled %}
      <section class="home-section" aria-labelledby="news-heading">
        <div class="section-heading">
          <h2 id="news-heading">News</h2>
          <a href="{{ '/news/' | relative_url }}">All updates <span aria-hidden="true">↗</span></a>
        </div>
        {% include news.liquid %}
      </section>
    {% endif %}
    {% if page.selected_papers %}
      <section class="home-section" id="research" aria-labelledby="research-heading">
        <div class="section-heading">
          <h2 id="research-heading">Publications &amp; preprints</h2>
          <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}"
            >Google Scholar <span aria-hidden="true">↗</span></a
          >
        </div>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}
    <section class="home-section" id="experience" aria-labelledby="experience-heading">
      <div class="section-heading">
        <h2 id="experience-heading">Industry experience</h2>
        <a href="{{ '/experience/' | relative_url }}">Full experience <span aria-hidden="true">↗</span></a>
      </div>
      {% include experience.liquid %}
    </section>
    {% if page.selected_projects %}
      <section class="home-section" id="engineering" aria-labelledby="engineering-heading">
        <div class="section-heading">
          <h2 id="engineering-heading">Open-source tools</h2>
          <a href="{{ '/projects/' | relative_url }}">Projects <span aria-hidden="true">↗</span></a>
        </div>
        {% include selected_projects.liquid %}
      </section>
    {% endif %}
    <section class="home-section" id="media" aria-labelledby="media-heading">
      <div class="section-heading"><h2 id="media-heading">Media &amp; interviews</h2></div>
      {% include reading_list.liquid entries=site.data.media %}
    </section>
    <section class="home-section" id="writing" aria-labelledby="writing-heading">
      <div class="section-heading">
        <h2 id="writing-heading">Selected writing</h2>
        <a href="https://x.com/{{ site.data.socials.x_username }}">More on X <span aria-hidden="true">↗</span></a>
      </div>
      {% include reading_list.liquid entries=site.data.writing %}
    </section>
    <section class="home-section" id="service" aria-labelledby="service-heading">
      <div class="section-heading"><h2 id="service-heading">Academic service</h2></div>
      {% include academic_service.liquid %}
    </section>
    {% if page.audit_bounties %}
      <section class="home-section" aria-labelledby="security-heading">
        <div class="section-heading"><h2 id="security-heading">Security practice</h2></div>
        <p>Alongside my research, I audit smart contracts and investigate vulnerabilities in blockchain applications.</p>
        {% include audit_bounties.liquid %}
      </section>
    {% endif %}
  </article>
</div>
