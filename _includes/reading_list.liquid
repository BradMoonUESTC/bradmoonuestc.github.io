<ul class="reading-list">
  {% assign entries = include.entries | sort: 'date' | reverse %}
  {% for item in entries %}
    <li class="reading-entry">
      <div class="reading-meta">
        <time datetime="{{ item.date | date: '%Y-%m-%d' }}">{{ item.date | date: '%b %Y' }}</time>
        <span>{{ item.kind }} · {{ item.publisher }} · {{ item.language }}</span>
      </div>
      <h3 class="reading-title">
        <a href="{{ item.url }}" lang="{{ item.title_lang }}">{{ item.title }}</a>
      </h3>
      <p>{{ item.description }}</p>
      <div class="reading-links">
        <a href="{{ item.url }}">
          {{- item.link_label }}
          <span aria-hidden="true">↗</span></a
        >
        {% if item.original_url %}
          <a href="{{ item.original_url }}">Original on X <span aria-hidden="true">↗</span></a>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
