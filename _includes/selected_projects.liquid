<div class="research-tools">
  {% for project in site.data.projects.featured %}
    <article class="tool-entry">
      <h3>
        <a href="{{ project.url }}">
          {{- project.name }}
          <span aria-hidden="true">↗</span></a
        >
      </h3>
      <p>{{ project.description }}</p>
      {% if project.github -%}
        <a class="tool-source" href="https://github.com/{{ project.github }}">Source code</a>
        {% if project.stars %}
          <a class="tool-stars" href="https://github.com/{{ project.github }}/stargazers" aria-label="{{ project.stars }} GitHub stars"
            >☆ {{ project.stars -}}
          </a>
        {% endif %}
      {%- endif %}
    </article>
  {% endfor %}
</div>
<p class="tool-stats-date">GitHub stars as of {{ site.data.projects.stars_updated | date: '%b %-d, %Y' }}.</p>
